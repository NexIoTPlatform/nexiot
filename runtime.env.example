# Copy to config/runtime.env and set the database password.
SERVER_PORT=9092
PG_DATASOURCE_URL='jdbc:postgresql://127.0.0.1:5432/nexiot?currentSchema=unix_tenant_202605'
PG_DATASOURCE_USERNAME=nexiot
PG_DATASOURCE_PASSWORD='replace-with-POSTGRES_PASSWORD'
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=''
MQTT_CFG_HOST='tcp://127.0.0.1:1883'
MQTT_CFG_HOST_OUT='tcp://127.0.0.1:1883'
MQTT_WS_URL='ws://127.0.0.1:8083/mqtt'
MQTT_CLIENT_USERNAME=''
MQTT_CLIENT_PASSWORD=''
REQUEST_SIGN_SECRET=nexiot
OAUTH2_ISSUER='http://localhost:9092'
JAVA_OPT='-Xms256m -Xmx1024m'
# Generate a separate persistent 32-character key before using certificate storage.
NEXIOT_CERTIFICATE_MASTER_KEY=''
NEXIOT_WECHAT_CRYPTO_KEY=''
NEXIOT_WECHAT_CALLBACK_BASE_URL=''
