<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.universal.persistence.mapper.admin.SysRoleMapper">
  <resultMap type="cn.universal.persistence.entity.admin.SysRole" id="SysRoleResult">
    <id property="roleId" column="role_id" />
    <result property="roleName" column="role_name" />
    <result property="roleKey" column="role_key" />
    <result property="roleSort" column="role_sort" />
    <result property="dataScope" column="data_scope" />
    <result property="tenantId" column="tenant_id" />
    <result property="roleType" column="role_type" />
    <result property="menuCheckStrictly" column="menu_check_strictly" jdbcType="SMALLINT"
      typeHandler="cn.universal.persistence.common.typehandler.PostgreSqlNumericBooleanTypeHandler" />
    <result property="deptCheckStrictly" column="dept_check_strictly" jdbcType="SMALLINT"
      typeHandler="cn.universal.persistence.common.typehandler.PostgreSqlNumericBooleanTypeHandler" />
    <result property="status" column="status" />
    <result property="createBy" column="create_by" />
    <result property="createTime" column="create_time" />
    <result property="updateBy" column="update_by" />
    <result property="updateTime" column="update_time" />
    <result property="remark" column="remark" />
  </resultMap>
  <sql id="selectRoleVo">
    select distinct r.role_id,
                    r.role_name,
                    r.role_key,
                    r.role_sort,
                    r.data_scope,
                    r.tenant_id,
                    r.role_type,
                    r.menu_check_strictly,
                    r.dept_check_strictly,
                    r.status,
                    r.create_by,
                    r.create_time,
                    r.update_by,
                    r.update_time,
                    r.remark
    from sys_role r
           left join sys_user_role ur on ur.role_id = r.role_id
  </sql>
  <select id="selectPageRoleList" parameterType="cn.universal.persistence.entity.admin.SysRole" resultMap="SysRoleResult" databaseId="postgresql">
    <include refid="selectRoleVo" />
    where 1=1
    <if test="role.roleName != null and role.roleName != ''">
      AND r.role_name like concat('%', #{role.roleName}, '%')
    </if>
    <if test="role.status != null and role.status != ''">
      AND r.status = #{role.status}
    </if>
    <if test="role.roleKey != null and role.roleKey != ''">
      AND r.role_key like concat('%', #{role.roleKey}, '%')
    </if>
    <if test="role.tenantId != null and role.tenantId != ''">
      AND r.tenant_id = #{role.tenantId}
    </if>
    <if test="role.roleType != null and role.roleType != ''">
      AND r.role_type = #{role.roleType}
    </if>
    <if test="role.params.beginTime != null and role.params.beginTime != ''">
      and r.create_time::date &gt;= cast(#{role.params.beginTime} as date)
    </if>
    <if test="role.params.endTime != null and role.params.endTime != ''">
      and r.create_time::date &lt;= cast(#{role.params.endTime} as date)
    </if>
    
    order by r.role_sort
  </select>
  <select id="selectRoleList" parameterType="cn.universal.persistence.entity.admin.SysRole" resultMap="SysRoleResult" databaseId="postgresql">
    <include refid="selectRoleVo" />
    <where>
      <if test="roleName != null and roleName != ''">
        AND r.role_name like concat('%', #{roleName}, '%')
      </if>
      <if test="status != null and status != ''">
        AND r.status = #{status}
      </if>
      <if test="roleKey != null and roleKey != ''">
        AND r.role_key like concat('%', #{roleKey}, '%')
      </if>
      <if test="tenantId != null and tenantId != ''">
        AND r.tenant_id = #{tenantId}
      </if>
      <if test="roleType != null and roleType != ''">
        AND r.role_type = #{roleType}
      </if>
      <if test="params.beginTime != null and params.beginTime != ''">
        and r.create_time::date &gt;= cast(#{params.beginTime} as date)
      </if>
      <if test="params.endTime != null and params.endTime != ''">
        and r.create_time::date &lt;= cast(#{params.endTime} as date)
      </if>
      <if test="createBy !=null and createBy != ''">
        and create_by=#{createBy}
      </if>
    </where>
    order by r.role_sort
  </select>
  <select id="selectRolePermissionByUnionId" parameterType="String" resultMap="SysRoleResult" databaseId="postgresql">
    <include refid="selectRoleVo" />
    WHERE ur.union_id= #{unionId}
  </select>
  <select id="selectRoleListByUnionId" parameterType="String" resultType="Long" databaseId="postgresql">
    select r.role_id
    from sys_role r
           left join sys_user_role ur on ur.role_id = r.role_id
    where ur.union_id = #{unionId}
  </select>
</mapper>
