<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.universal.persistence.mapper.admin.SysRoleDeptMapper">

  <resultMap type="cn.universal.persistence.entity.admin.SysRoleDept" id="SysRoleDeptResult">
    <result property="uuid" column="uuid"/>
    <result property="roleId" column="role_id"/>
    <result property="deptId" column="dept_id"/>
  </resultMap>

  <insert id="batchInsert">
    INSERT INTO sys_role_dept (
      uuid,
      role_id,
      dept_id
    )
    VALUES
    <foreach collection="roleDepts" item="item" separator=",">
      (
        #{item.uuid},
        #{item.roleId},
        #{item.deptId}
      )
    </foreach>
  </insert>

</mapper>
