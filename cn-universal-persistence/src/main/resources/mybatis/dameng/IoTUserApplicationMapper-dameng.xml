  <select id="countApplicationsByUnionId" resultType="long" databaseId="dameng">
    SELECT COUNT(*)
    FROM iot_user_application
    WHERE (tenant_id = (
      SELECT COALESCE(NULLIF(parent.tenant_id, ''), NULLIF(parent.union_id, ''), NULLIF(u.tenant_id, ''), NULLIF(u.union_id, ''), #{unionId})
      FROM iot_user u
      LEFT JOIN iot_user parent ON u.parent_union_id = parent.union_id
      WHERE u.union_id = #{unionId}
    )
      OR ((tenant_id is null or tenant_id = '')
      AND union_id = (
        SELECT COALESCE(NULLIF(parent.union_id, ''), NULLIF(u.union_id, ''), #{unionId})
        FROM iot_user u
        LEFT JOIN iot_user parent ON u.parent_union_id = parent.union_id
        WHERE u.union_id = #{unionId}
      )))
      AND deleted = 0
  </select>
