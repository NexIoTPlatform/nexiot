<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.universal.miniapp.mapper.MpUserMapper">
  <resultMap id="BaseResultMap" type="cn.universal.miniapp.entity.MpUser">
    <id column="id" property="id" />
    <result column="app_id" property="appId" />
    <result column="username" property="username" />
    <result column="password" property="password" />
    <result column="open_id" property="openId" />
    <result column="union_id" property="unionId" />
    <result column="phone" property="phone" />
    <result column="nickname" property="nickname" />
    <result column="avatar" property="avatar" />
    <result column="real_name" property="realName" />
    <result column="remark" property="remark" />
    <result column="status" property="status" />
    <result column="bind_time" property="bindTime" />
    <result column="last_login_time" property="lastLoginTime" />
    <result column="last_login_ip" property="lastLoginIp" />
    <result column="creator_id" property="creatorId" />
    <result column="create_time" property="createTime" />
    <result column="update_time" property="updateTime" />
    <result column="deleted" property="deleted" />
  </resultMap>
  <select id="selectByAppIdAndOpenId" resultMap="BaseResultMap" databaseId="dameng">
    SELECT *
    FROM mp_user
    WHERE app_id = #{appId}
      AND open_id = #{openId}
      AND deleted = 0
  </select>
  <select id="selectByAppIdAndPhone" resultMap="BaseResultMap" databaseId="dameng">
    SELECT *
    FROM mp_user
    WHERE app_id = #{appId}
      AND phone = #{phone}
      AND deleted = 0
  </select>
  <select id="selectByAppIdAndUsername" resultMap="BaseResultMap" databaseId="dameng">
    SELECT *
    FROM mp_user
    WHERE app_id = #{appId}
      AND username = #{username}
      AND deleted = 0
  </select>
  <select id="selectUserList" resultMap="BaseResultMap" databaseId="dameng">
    SELECT * FROM mp_user
    <where>
      deleted = 0
      <if test="scopeDenied == true">
        AND 1 = 0
      </if>
      <if test="appId != null and appId != ''">
        AND app_id = #{appId}
      </if>
      <if test="scopeAppIds != null and scopeAppIds.size() > 0">
        AND app_id IN
        <foreach collection="scopeAppIds" item="scopeAppId" open="(" separator="," close=")">
          #{scopeAppId}
        </foreach>
      </if>
      <if test="phone != null and phone != ''">
        AND phone LIKE CONCAT('%', #{phone}, '%')
      </if>
      <if test="nickname != null and nickname != ''">
        AND nickname LIKE CONCAT('%', #{nickname}, '%')
      </if>
      <if test="status != null">
        AND status = #{status}
      </if>
    </where>
    ORDER BY create_time DESC
  </select>
  <select id="countByAppId" resultType="int" databaseId="dameng">
    SELECT COUNT(*)
    FROM mp_user
    WHERE app_id = #{appId}
      AND deleted = 0
  </select>
  <update id="updateBindInfo" databaseId="dameng">
    UPDATE mp_user
    SET open_id     = #{openId},
        union_id    = #{unionId},
        status      = #{status},
        bind_time   = NOW(),
        update_time = NOW()
    WHERE id = #{id}
  </update>
</mapper>
